# Set the background to pure black
if-shell '[ "$NVIM_THEME" = "naysayer" ]' 'set -g status-style bg=#092a25,fg=#d0b892' 'set -g status-style bg=#000000,fg=white'

# Left side of status bar - show panes only
set -g status-left-length 30
if-shell '[ "$NVIM_THEME" = "naysayer" ]' 'set -g status-left "#[fg=#A6E22E]#[bg=#092a25] "' 'set -g status-left "#[fg=#17d87e]#[bg=#000000] "'

# Right side - show time, date, and session name
set -g status-right-length 60
# set -g status-right "#[fg=white]%H:%M:%S #[fg=white]%d-%m-%Y #[fg=white][#S]"
if-shell '[ "$NVIM_THEME" = "naysayer" ]' 'set -g status-right "#[fg=#d0b892]%d-%m-%Y #[fg=#d0b892][#S]"' 'set -g status-right "#[fg=white]%d-%m-%Y #[fg=white][#S]"'

# Center the window list and style it
set -g status-justify left

# Make the status bar update every second
set -g status-interval 1

# Set window list colors
if-shell '[ "$NVIM_THEME" = "naysayer" ]' 'setw -g window-status-current-style fg=#A6E22E,bg=#092a25' 'setw -g window-status-current-style fg=#17d87e,bg=#000000'
if-shell '[ "$NVIM_THEME" = "naysayer" ]' 'setw -g window-status-style fg=#126367,bg=#092a25' 'setw -g window-status-style fg=white,bg=#000000'

# Pane border colors
if-shell '[ "$NVIM_THEME" = "naysayer" ]' 'set -g pane-border-style fg=#126367' 'set -g pane-border-style fg=white'
if-shell '[ "$NVIM_THEME" = "naysayer" ]' 'set -g pane-active-border-style fg=#A6E22E' 'set -g pane-active-border-style fg=#17d87e'

# Search matches in copy mode
if-shell '[ "$NVIM_THEME" = "naysayer" ]' 'set -g copy-mode-match-style fg=#092a25,bg=#6a8f8c; set -g copy-mode-current-match-style fg=#092a25,bg=#e56a9f' 'set -g copy-mode-match-style default; set -g copy-mode-current-match-style default'
